rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Pesquisa psicossocial anônima ──────────────────────
    // Públicas — trabalhadores respondem via QR Code sem login.
    match /ergogro_campanhas/{id}  { allow read, write: if true; }
    match /ergogro_respostas/{id}  { allow read, write: if true; }

    // ── Dados de laudos ────────────────────────────────────
    // Leitura e exclusão: exige que o documento já pertença ao usuário.
    // Escrita (create/update): exige que o documento RESULTANTE
    // pertença ao usuário — permite migração de docs sem userId.

    match /ergogro_empresas/{id} {
      allow read, delete:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /ergogro_projetos/{id} {
      allow read, delete:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /ergogro_setores/{id} {
      allow read, delete:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /ergogro_funcoes/{id} {
      allow read, delete:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /ergogro_setores_master/{id} {
      allow read, delete:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /ergogro_funcoes_master/{id} {
      allow read, delete:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /ergogro_avaliacoes/{id} {
      allow read, delete:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /ergogro_planos/{id} {
      allow read, delete:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /ergogro_psicossocial/{id} {
      allow read, delete:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

  }
}
